# ==============================================================================
# Error2Expert — Production & Local Environment Variables Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- 1. PostgreSQL Database Configuration ---
# Standard JDBC URL (for local Docker or custom Postgres)
DB_URL=jdbc:postgresql://localhost:5432/codememory
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_DDL_AUTO=update

# Optional: Cloud Database URI (e.g., Render, Railway, Supabase, Neon)
# If provided, Spring Boot automatically converts postgres:// or postgresql:// to JDBC format
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- 2. Spring Boot Central Backend Configuration ---
SERVER_PORT=8080

# Security / JWT Secret (Base64 or 256-bit string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# --- 3. Python ML Microservice Configuration ---
ML_SERVICE_URL=http://localhost:8000
# EMBEDDING_ENGINE: 'auto' (downloads all-MiniLM-L6-v2) or 'lightweight' (low-RAM fast fallback)
EMBEDDING_ENGINE=auto

# --- 4. React Frontend Dashboard Configuration (Vite) ---
# When deployed, set to your live Spring Boot backend URL or leave empty for same-origin /api
VITE_API_URL=http://localhost:8080/api
VITE_ML_API_URL=http://localhost:8000

