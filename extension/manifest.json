{
  "manifest_version": 3,
  "name": "Error2Expert — AI Second Brain for Coding Mistakes",
  "version": "1.0.0",
  "description": "Learns from your LeetCode mistakes, classifies root causes with AI, and detects longitudinal weakness patterns.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://error2expert-backend.onrender.com/*",
    "https://error2expert-frontend.onrender.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Error2Expert Mistake Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "utils/parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://error2expert-frontend.onrender.com/*",
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "dashboard-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
